# ------------------------------------------------------------------
# Open Data Lab - variables de entorno (copiar a .env y rellenar)
# Nunca comitear el .env real.
# ------------------------------------------------------------------

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=odl
POSTGRES_PASSWORD=changeme
POSTGRES_DB=open_data_lab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- DuckDB ---
DUCKDB_PATH=./data/odl.duckdb

# --- MinIO (S3 local) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000

# --- Superset ---
SUPERSET_SECRET_KEY=change-this-secret-key

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- APIs oficiales (rellenar las que uses) ---
AEMET_API_KEY=
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
COPERNICUS_USER=
COPERNICUS_PASSWORD=
MAPBOX_TOKEN=

# --- Servicios cloud opcionales ---
MOTHERDUCK_TOKEN=
SUPABASE_URL=
SUPABASE_KEY=
